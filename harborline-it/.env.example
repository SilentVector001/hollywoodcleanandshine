# Copy this file to .env.local and fill in values. Never commit real keys.

# ---- Phase 1: site ----------------------------------------------------------
# Public URL of the site (used for SEO metadata, sitemap and email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Phase 2: lead database ---------------------------------------------------
# SQLite file for local dev. Use a Postgres URL in production (see README).
DATABASE_URL="file:./dev.db"

# ---- Later phases (not used yet) ---------------------------------------------

# Phase 3 (AI assistant) and Phase 4 (email drafts): Anthropic API key.
# ANTHROPIC_API_KEY=

# Phase 4 (automated follow-up): Resend API key and verified sender.
# RESEND_API_KEY=
# EMAIL_FROM="Harborline IT <hello@your-verified-domain.com>"

# Phase 5 (owner dashboard): admin password and session signing secret.
# ADMIN_PASSWORD=
# SESSION_SECRET=
